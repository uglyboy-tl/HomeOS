{
  "$schema": "https://opencode.ai/config.json",
  // 危险命令拦截；镜像构建时装好，运行时不联网
  "plugin": ["cc-safety-net"],
  // 搜索用 Exa，需要 EXA_API_KEY
  "websearch": { "provider": "exa" },
  // ask 没有超时、也没人能点确认，落到 ask 就永久卡住：可能 ask 的入口一律 deny
  "permissions": [
    // 内置基线对这两个是 ask
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "question", "resource": "*", "effect": "deny" },
    // 子代理自带更宽的权限，等于旁路
    { "action": "task", "resource": "*", "effect": "deny" },
    // 工作目录（web/）之外不碰，只放行 /tmp 给临时脚本
    { "action": "external_directory", "resource": "*", "effect": "deny" },
    { "action": "external_directory", "resource": "/tmp/**", "effect": "allow" },
    { "action": "edit", "resource": "/tmp/**", "effect": "allow" }
  ],
  // 上游只有 low/high/max，none 是我们造的变体（chat 不要思考链）
  "providers": {
    "opencode-go": {
      // 不落 auth.json，只从环境变量读（config/homeos.yaml 的 go_api_key）
      "settings": { "apiKey": "{env:OPENCODE_GO_API_KEY}" },
      "models": {
        "deepseek-v4.1-flash": {
          "variants": [
            { "id": "none", "body": { "chat_template_kwargs": { "thinking": false } } }
          ]
        }
      }
    }
  }
}
